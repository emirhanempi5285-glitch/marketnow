# MarketNow — HTTP Headers (Cloudflare Pages / GitHub Pages compatible)
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY HEADERS — applied to all routes
# ═══════════════════════════════════════════════════════════════════════════
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://marketnow.site"), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-XSS-Protection: 1; mode=block
  # CSP: allow self + inline styles (Tailwind) + data URIs (icons) + Base RPC for MetaMask
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://marketnow.site https://*.marketnow.site https://mainnet.base.org https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# ═══════════════════════════════════════════════════════════════════════════
# API — JSON, CORS open for agent consumption, cache 1h
# ═══════════════════════════════════════════════════════════════════════════
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

# ═══════════════════════════════════════════════════════════════════════════
# Static assets — long cache, immutable
# ═══════════════════════════════════════════════════════════════════════════
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ═══════════════════════════════════════════════════════════════════════════
# HTML root — no cache (agents always see fresh version)
# ═══════════════════════════════════════════════════════════════════════════
/
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: index, follow
  X-MarketNow-API: https://www.marketnow.site/api/skills.json
  X-MarketNow-Agent: https://www.marketnow.site/api/agent.json
