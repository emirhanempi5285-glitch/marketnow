# Cloudflare Pages — HTTP Headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# ✅ CORS abierto para el API de skills — cualquier agente puede hacer fetch
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8

# ✅ Cache largo para assets estáticos del SPA
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ✅ Sin cache en el HTML raíz (para que los agentes siempre vean versión fresca)
/
  Cache-Control: no-cache
  X-Robots-Tag: index, follow
  X-MarketNow-API: https://www.marketnow.site/api/skills.json
