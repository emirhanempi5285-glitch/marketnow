{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/categories.json", "destination": "/api/categories" },
    { "source": "/api/manifest.json", "destination": "/api/manifest" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
