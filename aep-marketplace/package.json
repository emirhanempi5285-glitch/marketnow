{
  "name": "aep-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "node generate_skills.cjs",
    "prebuild": "node generate_skills.cjs",
    "dev": "node generate_skills.cjs && vite",
    "dev:mcp": "cd mcp-server && node --watch index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:mcp\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mcp:install": "cd mcp-server && npm install",
    "mcp:start": "cd mcp-server && npm start"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
